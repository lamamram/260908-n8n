    {
      "parameters": {
        "jsCode": "// Run Once All Items permet d'utiliser $input.all(), $input.first(), last() ...\n// Run Once for Each Item permet d'utiliser\n// $input.item => on est dans une boucle for\nlet counts = {};\nconst stats = $input.first().json.stats;\nfor (const item of stats) {\n  if (item in counts) {\n    counts[item] += 1; \n  }\n  else {\n    counts[item] = 1;\n  }\n}\nconst nb_messages = stats.length;\n// debug: console.log(counts)\nconst output = [];\nfor (const [key, value] of Object.entries(counts)) {\n  output.push({\"message\": key, \"percent\": Math.round(value / nb_messages * 100) });\n}\n// REM: c'est à nous de structurer la sortie comme souhaitée par n8n !!!\nreturn output.map(o => ({\"json\": o}));"
      },
